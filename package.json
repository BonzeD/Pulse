{
  "name": "pulse-repository",
  "private": true,
  "productName": "Pulse",
  "version": "1.0.1",
  "description": "Pulse — неоновый плеер-клиент для YouTube Music, Apple Music и Spotify",
  "author": "werxapee & Daswi",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "npm --prefix app run start",
    "dist": "npm --prefix app run dist",
    "test": "npm --prefix app test && node scripts/check-structure.cjs",
    "test:ui": "npm --prefix app run test:ui",
    "test:audio": "npm --prefix app run test:audio",
    "test:electron": "npm --prefix app run test:electron",
    "build:media": "npm --prefix app run build:media",
    "test:ui-fixes": "npm --prefix app run test:ui-fixes",
    "test:hotfix": "npm --prefix app run test:hotfix",
    "test:fade-bar": "npm --prefix app run test:fade-bar",
    "test:local": "npm --prefix app run test:local",
    "build:graphics": "npm --prefix app run build:graphics",
    "test:experience": "npm --prefix app run test:experience",
    "test:widget-clicks": "npm --prefix app run test:widget-clicks",
    "test:file-video": "npm --prefix app run test:file-video",
    "test:glass": "npm --prefix app run test:glass",
    "test:glass-editor": "npm --prefix app run test:glass-editor",
    "test:final-ui": "npm --prefix app run test:final-ui",
    "test:final-effects": "npm --prefix app run test:final-effects",
    "test:kinetic-motion": "npm --prefix app run test:kinetic-motion",
    "test:settings-art": "npm --prefix app run test:settings-art",
    "postinstall": "npm --prefix app ci",
    "test:structure": "node scripts/check-structure.cjs",
    "source": "python3 app/build/source-archive.py",
    "test:visual-performance": "npm --prefix app run test:visual-performance",
    "test:release-101": "npm --prefix app run test:release-101",
    "test:timecode": "npm --prefix app run test:timecode"
  }
}
