          "  const c = now(), w = st.dur ? Math.min(100, (c / st.dur) * 100).toFixed(2) + '%' : '0';\n",
          "  if (w !== lastW) { lastW = w; $('fill').style.width = w; }\n",
          "  setTxt('tc', fmt(c)); setTxt('td', st.dur ? fmt(st.dur) : '0:00');\n",
          "  frame();\n",
          "}, 80);\n"
        ]
      }
    ]
  }
}
